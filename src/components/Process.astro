---
const steps = [
  { n: '01', title: 'Заявка и созвон', text: 'Обсуждаем задачу бесплатно, без обязательств.' },
  { n: '02', title: 'Бриф и оценка', text: 'Фиксируем объём, сроки и стоимость.' },
  { n: '03', title: 'Разработка с промежуточными демо', text: 'Видите прогресс, а не тишину до сдачи.' },
  { n: '04', title: 'Запуск и поддержка', text: 'Передаю доступы и код, остаюсь на связи после запуска.' },
];
---
<section id="process" class="section process">
  <h2>Как проходит работа</h2>
  <ol class="process__list">
    {steps.map((step) => (
      <li class="process__step reveal">
        <span class="process__marker">{step.n}</span>
        <div class="process__card">
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .process__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  .process__list::before {
    content: '';
    position: absolute;
    top: 22px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
    opacity: 0.5;
  }
  .process__step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .process__marker {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(135deg, var(--color-accent), var(--color-accent-2)) border-box;
    border: 1px solid transparent;
  }
  .process__card {
    flex: 1;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
  }
  .process__card h3 { margin: 0 0 0.4rem; font-size: 1.05rem; }
  .process__card p { margin: 0; font-size: 0.95rem; }
  @media (max-width: 860px) {
    .process__list { grid-template-columns: 1fr; gap: 1.75rem; }
    .process__list::before {
      top: 0;
      bottom: 0;
      left: 21px;
      right: auto;
      width: 1px;
      height: auto;
      background: linear-gradient(180deg, var(--color-accent), var(--color-accent-2));
    }
    .process__step { flex-direction: row; gap: 1.25rem; align-items: flex-start; }
    .process__card { padding: 1rem 1.25rem; }
  }
</style>
